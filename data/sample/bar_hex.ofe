OpenFEM 1 0
title = 3D eddy current (A-phi) on a hexahedral mesh
#
# bar_eddy と同じ導体棒 (2mm x 0.25mm x 1mm、24x2x24) を**六面体**で切る。
#
#   python3 mkmesh.py bar_hex bar_hex.msh
#
# 幾何・物理タグ・1 次元厳密解 Z = γL/(2σW tanh(γt/2)) は四面体版と同じ。
# 六面体の辺要素 (12 辺) が同じ閉形式に一致することを見る。
# awall (タグ 20) の面は四角形になる (awall_mark が四角形の 4 辺を固定する)。
#
mesh = bar_hex.msh
material = 1.0 5.8e7
region = 1 2
electrode = 10 0
electrode = 11 1
awall = 20
frequency = 1e5
voltage = 1.0

analysis = A
solver = 50000 2000 1e-9
end
