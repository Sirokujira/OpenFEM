OpenFEM 1 0
title = order-2 hexahedron self test (rectangular mesh, quadratic identity)
#
# 2 次六面体の**2 次場の恒等式** phi = a.r + r^T B r / 2 (gmsh の長方形格子)。
#
# 線形場の恒等式は 2 次特有の基底 (辺・面・体心) の係数の誤りの多くを
# 素通りする (grad phi が定数になるため)。**2 次の基底と積分則を検査するのは
# この恒等式だけ**なので、要素がアフィンになる長方形格子で実行する。
# 期待値は直方体の閉形式モーメントから組む (組み立てとは独立)。
#
mesh = box_hex2s.msh
material = 4.0 0
region = 1 2
electrode = 10 0
electrode = 11 1

analysis = P
end
