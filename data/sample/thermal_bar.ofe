OpenFEM 1 0
title = electro-thermal coupling : a current-carrying bar cooled at both ends
#
# 電気-熱連成 (thermal) の 1 次元厳密解との比較。
# 棒 (長さ L = 10mm、断面 A = 1mm x 1mm) に電流 I を流し、両端の電極を
# ヒートシンク (T_s = 20 degC) にする。側面は断熱 (自然境界条件)。
#
#   ρ(T) = ρ0 (1 + α (T - T0)),  ρ0 = 1/σ0 = 1e-6 [Ωm], α = 4e-3 [1/K], T0 = 0 [degC]
#   k = 10 [W/(m K)],  J = I / A
#
# 電流は棒の中で一様 (J = I/A) なので、熱の式は T について**線形**になる:
#   -k T'' = J² ρ(T)
# θ = T - T_s, ρ_s = ρ0 (1 + α (T_s - T0)), α' = α / (1 + α (T_s - T0)) とおくと
#   θ'' + m² θ = -J² ρ_s / k,   m² = J² ρ0 α / k
# 両端 θ = 0 の解と、そこから出る抵抗:
#   θ(x) = (1/α') [cos(m (x - L/2)) / cos(mL/2) - 1]
#   R    = (1/A) ∫ ρ dx = (ρ_s L / A) tan(mL/2) / (mL/2)
#   T_max = T_s + (1/α') (1/cos(mL/2) - 1)
# α < 0 (NTC) では cos -> cosh, tan -> tanh になる。α -> 0 で R = ρ_s L/A と
# 放物線 T_max = T_s + J² ρ_s L² / (8k) に戻る。
#
# **mL = π で定常解が無くなる** (熱暴走: 抵抗の増加が発熱を増やし、熱伝導が
# 追いつかない)。この棒では臨界電流 I_c = (π/L) sqrt(k/(ρ0 α)) A = 15.708 [A]。
#
# I = 7.5 [A] : J = 7.5e6, m = 150 [1/m], mL = 1.5
#   ρ_s = 1.08e-6, α' = 4e-3/1.08
#   R     = 1.08e-2 * tan(0.75)/0.75 = 1.3414989023e-02 [ohm]   (冷えた棒の +24%)
#   T_max = 20 + 270 * (1/cos(0.75) - 1) = 1.1900930366e+02 [degC]
#
# 要素の温度は 8 節点の平均 (要素内で σ を一定にする) なので離散化誤差は h²。
# 40 分割で R -0.018%、20 分割との誤差比は 4.00 (rlc_check.sh で見る)。
# temperature = 50 は反復の初期値 (と σ の入力補正) で、収束後の答えは
# これに依らない。T0 / ヒートシンク / 初期値の温度をすべて変えてあるのは、
# どれか 1 つでも 1 になる因子があるとその因子の誤りが見えなくなるため。
#
xmesh = 0 40 0.01
ymesh = 0 1 1e-3
zmesh = 0 1 1e-3

material = 1.0 1e6
tempco = 2 4e-3 0
kthermal = 2 10
geometry = 2 1 0 0.01 0 1e-3 0 1e-3

conductor = 0 1 0    0    0 1e-3 0 1e-3
conductor = 1 1 0.01 0.01 0 1e-3 0 1e-3
heatsink = 0 20
heatsink = 1 20

temperature = 50
thermal = 7.5
analysis = R
solver = 20000 500 1e-12
end
