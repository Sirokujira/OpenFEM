OpenFEM 1 0
title = rotating field in a hysteretic square (vector Jiles-Atherton)
#
# **ベクトル J-A (javector = 1) の回転磁界。** 2 mm 角の J-A の試料 (材料 2) の上 (ポート 1) と
# 右 (ポート 2) に導体を置き、帰路 (導体 0) を左下に置く。I1 = A cos θ、I2 = A sin θ
# (currentsweep / currentsweep2) で試料の中心の場が回転する (楕円)。最初の 4 点は I1 だけを
# 0 -> A に上げる。1 回転 24 点 x 2 回転、A = 1000 A (試料の |B| は最大 0.7 T)。
#
# 検証 (rlc_check.sh の [javector]):
#   - japrobe の Gauss 点の H の列を折れ線でつなぎ、H 駆動の順方向のベクトル J-A を awk で独立に
#     積分した B = μ0 (H + M) が FEM の B に 1.8e-2 (1 回転 48 点で 4.4e-3、比 4.2 = 2 次)
#   - 端子の仕事 Σ Ī ΔΛ = 磁気の仕事 ∫ H・ΔB (台形則、反復の打ち切りを除いて厳密)
#
xmesh = 0 12 6e-3
ymesh = 0 12 6e-3
zmesh = 0 1 1e-4
