geometry = 2 1 2e-3 4e-3 2e-3 4e-3 0 1e-4
conductor = 0 1 0.5e-3 1e-3 0.5e-3 1e-3 0 1e-4
conductor = 1 1 2e-3 4e-3 5e-3 5.5e-3 0 1e-4
conductor = 2 1 5e-3 5.5e-3 2e-3 4e-3 0 1e-4
